# Local development only. Copy to .env and choose a unique local password.
POSTGRES_USER=case_dev
POSTGRES_PASSWORD=replace-with-a-local-only-password
POSTGRES_DB=case_management_dev
DATABASE_URL=postgresql://case_dev:replace-with-a-local-only-password@127.0.0.1:5432/case_management_dev?schema=public
# Create this separate database before npm run test:db. It must end with _test.
TEST_DATABASE_URL=postgresql://case_dev:replace-with-a-local-only-password@127.0.0.1:5432/case_management_test?schema=public
PORT=3000
APP_ORIGIN=http://localhost:4200
# Generate a unique random 32+ byte value locally; never commit the actual secret.
CSRF_SECRET=
