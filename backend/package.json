{
  "name": "case-management-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "npm run build && npm run start",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "admin:bootstrap": "node dist/src/auth/bootstrap-admin.js",
    "test": "jest --runInBand --testPathIgnorePatterns=test/postgres.integration.spec.ts",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=test/postgres.integration.spec.ts",
    "test:db": "node test/run-db-tests.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.6",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
