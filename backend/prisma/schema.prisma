generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          Int       @id @default(autoincrement())
  projectCode String    @unique(map: "projects_project_code_key") @map("project_code") @db.VarChar(32)
  name        String    @db.VarChar(50)
  description String?   @db.Text
  status      String    @default("pending") @db.VarChar(16)
  priority    String    @default("medium") @db.VarChar(16)
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([status, updatedAt(sort: Desc), id(sort: Desc)], map: "projects_status_updated_id_idx")
  @@index([updatedAt(sort: Desc), id(sort: Desc)], map: "projects_updated_id_idx")
  @@map("projects")
}

model ProjectCodeCounter {
  year         Int     @id
  lastSequence Decimal @map("last_sequence") @db.Decimal(23, 0)

  @@map("project_code_counters")
}

enum UserRole {
  admin
  manager
  staff

  @@map("user_role")
}

enum UserStatus {
  pending_activation
  active
  disabled

  @@map("user_status")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(120)
  email        String     @unique(map: "users_email_key") @db.VarChar(254)
  passwordHash String?    @map("password_hash") @db.Text
  role         UserRole
  status       UserStatus @default(pending_activation)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)
  disabledAt   DateTime?  @map("disabled_at") @db.Timestamptz(3)
  sessions     Session[]

  @@map("users")
}

model Session {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  tokenHash         String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt], map: "sessions_user_revoked_idx")
  @@index([idleExpiresAt], map: "sessions_idle_expires_idx")
  @@index([absoluteExpiresAt], map: "sessions_absolute_expires_idx")
  @@map("sessions")
}
